generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  email        String        @id
  name         String
  phone        String?
  currency     String        @default("United States - USD")
  subscribed   Boolean       @default(false)
  portfolios   Portfolio[]
  supports     Support[]
  feedbacks    Feedback[]
  subscription Subscription?
}

model Subscription {
  id                     String    @id @default(uuid())
  createdDate            DateTime  @default(now())
  updatedDate            DateTime  @updatedAt
  provider               String    @default("DODO")
  status                 String    @default("PENDING") // PENDING | ACTIVE | PAST_DUE | CANCELLED | EXPIRED | FAILED
  providerSubscriptionId String?   @unique
  currentPeriodEnd       DateTime?
  amount                 Int?
  currency               String?
  ownerEmail             String    @unique
  owner                  User      @relation(fields: [ownerEmail], references: [email])
}

// Idempotency ledger: every webhook id we've already handled.
model ProcessedWebhook {
  webhookId  String   @id
  type       String?
  receivedAt DateTime @default(now())
}

model Portfolio {
  id                String        @id @default(uuid())
  createdDate       DateTime      @default(now())
  updatedDate       DateTime      @updatedAt
  portfolioName     String        @unique /// @encrypted
  portfolioNameHash String?       @unique /// @encryption:hash(portfolioName)
  transactions      Transaction[]
  ownerEmail        String
  owner             User          @relation(fields: [ownerEmail], references: [email])

  @@unique([ownerEmail, portfolioName])
}

model Transaction {
  id              String          @id @default(uuid())
  createdDate     DateTime        @default(now())
  updatedDate     DateTime        @updatedAt
  transactionName String /// @encrypted
  type            TransactionType
  amount          Int
  transactionDate DateTime
  comments        String? /// @encrypted
  portfolioId     String
  portfolio       Portfolio       @relation(fields: [portfolioId], references: [id])

  @@unique([transactionName, type, transactionDate, amount, portfolioId])
}

model Support {
  id          String        @id @default(uuid())
  createdDate DateTime      @default(now())
  reason      SupportReason
  concern     String
  resolved    Boolean       @default(false)
  ownerEmail  String
  owner       User          @relation(fields: [ownerEmail], references: [email])

  @@unique([ownerEmail, concern, reason])
}

model Feedback {
  id          String   @id @default(uuid())
  createdDate DateTime @default(now())
  rating      Int
  comments    String?
  ownerEmail  String
  owner       User     @relation(fields: [ownerEmail], references: [email])

  @@unique([ownerEmail, rating, comments])
}

enum TransactionType {
  DR
  CR
}

enum SupportReason {
  GI
  FR
  TS
  IS
}
