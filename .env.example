# =============================================================================
# ROI Monk — environment variables
# =============================================================================
# Copy this file to `.env.local` (git-ignored) and fill in the values.
# NEXT_PUBLIC_* variables are exposed to the browser — never put secrets there.
# =============================================================================

# -----------------------------------------------------------------------------
# Database (Postgres — Neon)
# -----------------------------------------------------------------------------
# Full Postgres connection string. Used by Prisma (lib/db.js, prisma.config.mjs).
# How to get: Neon dashboard (https://neon.tech) → your project → "Connection
# string". Use the pooled `-pooler` host for serverless/Vercel. Include
# `?sslmode=require`.
DATABASE_URL=

# -----------------------------------------------------------------------------
# Clerk (authentication)
# -----------------------------------------------------------------------------
# How to get: Clerk dashboard (https://dashboard.clerk.com) → your app →
# "API Keys". Publishable key is public; secret key must stay server-side.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Route paths for the sign-in/sign-up pages and where to land afterwards.
# These are app routes, not secrets — the defaults below match this project.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard

# -----------------------------------------------------------------------------
# App URLs
# -----------------------------------------------------------------------------
# DOMAIN: canonical site URL used for SEO/OpenGraph metadata (config/site.js).
# Example: https://roimonk.com  (no trailing slash)
DOMAIN=

# -----------------------------------------------------------------------------
# Dodo Payments (subscriptions)
# -----------------------------------------------------------------------------
# How to get: Dodo dashboard (https://app.dodopayments.com) → Developer →
# "API Keys". Use a test-mode key while developing.
DODO_PAYMENTS_API_KEY=
# Which Dodo environment the server SDK talks to: test_mode | live_mode
DODO_PAYMENTS_ENVIRONMENT=test_mode
# Webhook signing secret: Dodo dashboard → Developer → Webhooks → your endpoint
# (points at /api/webhooks/dodo) → "Signing secret".
DODO_PAYMENTS_WEBHOOK_KEY=
# The product/subscription id customers check out with.
# Dodo dashboard → Products → open the product → copy its ID.
DODO_SUBSCRIPTION_PRODUCT_ID=
# Client-side flag mirroring the environment above: test | live (payment-utils.js)
NEXT_PUBLIC_DODO_MODE=test

# -----------------------------------------------------------------------------
# PostHog (product analytics + error tracking)
# -----------------------------------------------------------------------------
# Client SDK (instrumentation-client.js). How to get: PostHog → Settings →
# "Project" → Project API key + region host.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# Server-side insights API (lib/posthog-insights.js).
# POSTHOG_PROJECT_ID: PostHog → Settings → Project → "Project ID" (numeric).
POSTHOG_PROJECT_ID=
# POSTHOG_PERSONAL_API_KEY: PostHog → Account → Personal API keys → "Create key"
# (grant "Query Read" scope). Secret — server only.
POSTHOG_PERSONAL_API_KEY=
POSTHOG_API_HOST=https://us.posthog.com

# -----------------------------------------------------------------------------
# Email (Nodemailer over Zoho SMTP — smtp.zoho.in:465)
# -----------------------------------------------------------------------------
# One mailbox per purpose (lib/mail-config.js). Each PASSWORD is a Zoho
# app-specific password, NOT the account login password.
# How to get: Zoho Mail → Settings → Security → App Passwords → generate one
# per mailbox.
SUPPORT_EMAIL=
SUPPORT_PASSWORD=

CONTACT_EMAIL=
CONTACT_PASSWORD=

FEEDBACK_EMAIL=
FEEDBACK_PASSWORD=

AKSHAT_EMAIL=
AKSHAT_PASSWORD=

# Address that is BCC'd on outgoing mail (actions/mail.js, webhook receipts).
BCC_EMAIL=

# -----------------------------------------------------------------------------
# Field-level encryption (Prisma)
# -----------------------------------------------------------------------------
# Encrypts portfolio/transaction fields at rest (lib/field-encryption.js).
# How to get: generate a key with `npx cloak generate` (prisma-field-encryption)
# and paste the `k1.aesgcm256.*` value here. Losing this key makes encrypted
# data unrecoverable — back it up securely.
PRISMA_FIELD_ENCRYPTION_KEY=

# -----------------------------------------------------------------------------
# Referral tracking
# -----------------------------------------------------------------------------
# Endpoint pinged when a visitor arrives with a non-"rec" ?ref= code (proxy.js).
# Set to your referral/attribution service URL. Optional — referral pings are
# skipped in local dev if unset.
REF_SERVICE=
